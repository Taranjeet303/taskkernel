
flow database_test {
    // 1. Fetch real data from an external API
    let response = http_get("https://jsonplaceholder.typicode.com/users/1")
    print(response)

    // 2. Insert API response data into PostgreSQL
    let insert_result = db_insert("customers", {
        "name": response.body.name,
        "city": response.body.address.city,
        "email": response.body.email
    })
    print(insert_result)

    // 3. Retrieve the inserted data
    let result = db_query("SELECT * FROM customers WHERE email = 'Sincere@april.biz'")
    print(result)
}
