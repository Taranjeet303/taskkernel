flow interpreter_tests {

    # =========================
    # 1. Variables & Arithmetic
    # =========================

    step "Variables" {
        let x = 10
        let y: Number = 20
        let z = x + y * 2

        print(z)

        x = x + 1
        print(x)
    }

    # =========================
    # 2. If / Else
    # =========================

    step "Conditionals" {
        let value = 10

        if value > 5 {
            print("IF PASSED")
        }
        else {
            print("IF FAILED")
        }
    }

    # =========================
    # 3. While Loop
    # =========================

    step "While Loop" {
        let counter = 0

        while counter < 3 {
            print(counter)
            counter = counter + 1
        }
    }

    # =========================
    # 4. For Loop + List
    # =========================

    step "For Loop" {
        let users = ["Alice", "Bob", "Charlie"]

        for user in users {
            print(user)
        }
    }

    # =========================
    # 5. Dictionary / Property Access
    # =========================

    step "Collections" {
        let person = {
            "name": "John",
            "age": 25
        }

        print(person.name)
        print(person.age)
    }

    # =========================
    # 6. User-defined Tasks
    # =========================

    task greet(name: String) {
        print(name)
        return
    }

    task add(a: Number, b: Number) {
        let result = a + b
        return result
    }

    step "Tasks" {
        greet("Backend Team")

        let total = add(5, 10)
        print(total)
    }

    # =========================
    # 7. Builtin HTTP
    # =========================

    step "HTTP Request" {
        let response = http_get("https://api.github.com/issues")

        if response.status == 200 {
            print("HTTP PASSED")
        }
        else {
            print("HTTP FAILED")
        }
    }

    # =========================
    # 8. on_fail
    # =========================

    step "Failure Test" {
        unknown_operation()
    }

    on_fail {
        print("ON_FAIL PASSED")
    }

    # =========================
    # 9. Math / Parentheses
    # =========================

    step "Math" {
        print((10 + 20) * 3)
        print(10 + 20 * 3)
    }
   let x = 10

task shadow_test() {
    let x = 50
    return x
}

step "Scope Test" {
    print(shadow_test())
    print(x)
}
}